# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It carries no live values and it is the only record
# of which keys a deployment has to set — ignoring it means a new environment
# has to be reverse-engineered from `process.env` call sites.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env*.local

# design reference bundle (kept locally, not app source)
# design_handoff_shiv_events/

# Generated Prisma client (14 MB, includes a 3.5 MB wasm binary). Regenerated
# by the `postinstall` script, so committing it only adds weight and a merge
# conflict on every schema change.
/src/generated/

# --- Core ---------------------------------------------------------------
# Ports are offset from the defaults (5433/6380) so this stack does not
# collide with any Postgres/Redis already running on the machine.
DATABASE_URL="postgresql://shiv:shiv_dev_password@localhost:5433/shiv_events?schema=public"
# On a pooled host (Neon, Supabase) DATABASE_URL is the POOLED endpoint — the
# app opens a real pg pool per instance. Migrations need a session-level
# connection PgBouncer cannot give, so the Prisma CLI prefers this one.
# Leave unset locally; it falls back to DATABASE_URL.
# DIRECT_DATABASE_URL=""
REDIS_URL="redis://localhost:6380"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CITY="ahmedabad"

# --- Secrets (dev values; replace in every real environment) -------------
# Session JWT, 30-day rolling (spec C1.3)
SESSION_JWT_SECRET="dev-only-session-secret-change-me-in-production-32b"
# Signs QR payloads. Rotating this invalidates every issued ticket QR.
QR_JWT_SECRET="dev-only-qr-secret-change-me-in-production-32bytes"

# --- Adapters -----------------------------------------------------------
# Each adapter resolves a driver by name. "sandbox" is a fully functional
# in-process fake: it exercises the real webhook, idempotency and
# reconciliation paths without any vendor account.
PAYMENTS_DRIVER="sandbox"      # sandbox | razorpay
SMS_DRIVER="sandbox"           # sandbox | msg91 | twilio
EMAIL_DRIVER="sandbox"         # sandbox | ses | resend | postmark
WHATSAPP_DRIVER="sandbox"      # sandbox | gupshup | meta
GEOCODE_DRIVER="sandbox"       # sandbox | google | mapbox
STORAGE_DRIVER="local"         # local | s3

# Sandbox-only behaviour switches
SANDBOX_OTP_CODE="123456"          # fixed OTP so dev login never needs SMS
SANDBOX_PAYMENT_FAIL_RATE="0"      # 0..1, forces payment.failed webhooks
SANDBOX_WEBHOOK_DELAY_MS="600"     # simulates gateway webhook latency

# Real gateway credentials (unused while PAYMENTS_DRIVER=sandbox)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Map ----------------------------------------------------------------
# Raster tile template. The default is OpenStreetMap's public endpoint, which
# needs no key but is rate-limited and unsuitable for production traffic —
# point this at a paid provider (or your own proxy) before launch, and update
# the attribution to whatever that provider's licence requires.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# --- Demo build ----------------------------------------------------------
# Enables: fixed OTP sign-in, UNVERIFIED email+password sign-up, and a
# simulated payment screen with test cards. Anyone can sign in as anyone,
# including the seeded admins — never expose a DEMO_MODE build publicly.
# The server refuses to boot with this on in production unless
# DEMO_MODE_ALLOW_PRODUCTION=true acknowledges it is behind access control.
DEMO_MODE="true"
# DEMO_MODE_ALLOW_PRODUCTION="false"

# --- Access control ------------------------------------------------------
# HTTP Basic gate enforced by src/middleware.ts across the whole site (except
# the signature-verified payment webhook, which no gateway could authenticate
# to). Unset = no gate, which is what local development wants.
#
# REQUIRED whenever DEMO_MODE_ALLOW_PRODUCTION=true: the server refuses to
# boot on that combination without it, because "this deploy is behind access
# control" has to be backed by something that actually gates it.
# SITE_PASSWORD=""

# --- Workers -------------------------------------------------------------
# BullMQ needs a long-lived process holding blocking Redis commands, which a
# serverless instance is not. Set "true" only on a dedicated worker process;
# leave unset in development, where it defaults on so one `npm run dev` runs
# the whole booking flow. Web instances without workers are supported — every
# job has a synchronous fallback (D-022).
# RUN_WORKERS="false"
